; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hull Down"
config/description="Turn-based tank tactics. Iteration 1: terrain, camera, movement, visibility."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
; "disabled" makes the root viewport track the window exactly, so resizing shows more world instead
; of letterboxing and upscaling a fixed 1600x900 frame. It also keeps mouse picking honest:
; TilePicker feeds raw event positions into Camera3D.project_ray_origin, and under a scaled canvas
; those two are in different spaces. Camera3D.keep_aspect defaults to KEEP_HEIGHT, so a wider window
; gains horizontal field of view. The HUD is then in raw pixels and scales its own fonts against
; look.hud.reference_height.
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
